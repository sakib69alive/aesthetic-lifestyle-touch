# ================================================================
# SSLCommerz sandbox credentials — get these free in ~5 minutes:
#   1. Go to https://developer.sslcommerz.com/registration/
#   2. Fill in your name/email/phone and any domain (e.g. localhost
#      is fine for testing) — no business documents needed for sandbox.
#   3. Verify your email, then find "Store ID" and "Store Password"
#      in your sandbox merchant panel.
#   4. Copy this file to ".env" and paste them in below.
# When you later register a LIVE SSLCommerz account, just swap
# SSLCOMMERZ_IS_LIVE to true and use your live store_id/store_passwd —
# nothing else in this server needs to change.
# ================================================================
SSLCOMMERZ_STORE_ID=your_sandbox_store_id
SSLCOMMERZ_STORE_PASSWD=your_sandbox_store_password
SSLCOMMERZ_IS_LIVE=false

# The URL this server itself is reachable at (SSLCommerz redirects/IPN
# calls come back here). For local testing this is fine as-is.
SERVER_BASE_URL=http://localhost:4000

# The URL of the actual storefront (checkout.html etc.) — after a
# payment finishes, the server redirects the browser back here.
SITE_BASE_URL=http://localhost:5500

PORT=4000
